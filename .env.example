# Copy to .env (cp .env.example .env). The backend reads this file from the repo root.

# --- API server ---
PORT=4000

# --- MongoDB (started by `npm run infra:up`) ---
MONGODB_URI=mongodb://localhost:27018/cineos

# --- Redis (started by `npm run infra:up`) ---
# BullMQ uses Redis for the job queue; port 6380 avoids collisions with any existing Redis.
REDIS_URL=redis://localhost:6380

# --- BullMQ worker ---
# How many agent jobs the worker processes in parallel. Keep at 2 on the free Gemini tier.
WORKER_CONCURRENCY=2

# --- LLM: Google Gemini (free tier) ---
# Get a free key at https://aistudio.google.com/apikey (no billing needed for the free tier).
# Free-tier prompts and responses may be used by Google to improve its products: don't enter private data.
#
# LLM_MODE:
#   auto   -> Gemini when GEMINI_API_KEY is set, otherwise deterministic mock mode
#   gemini -> always use Gemini (startup fails if GEMINI_API_KEY is missing)
#   mock   -> always use deterministic mock output (clearly labelled as MOCK in the API and UI)
LLM_MODE=auto
GEMINI_API_KEY=
# Any Gemini model available on your tier, e.g. gemini-4-hydrogen, gemini-3.8-flash, gemini-3.5-flash-lite
LLM_MODEL=gemini-4-hydrogen
LLM_MAX_TOKENS=16000

# Artificial per-agent delay in mock mode so progress is visible in the dashboard (0 disables)
MOCK_LATENCY_MS=800

# --- Media processing (FFmpeg) ---
# Requires ffmpeg + ffprobe on the PATH (Ubuntu: sudo apt-get install -y ffmpeg).
# Renders, scene cards and scratch files are stored under MEDIA_ROOT (default: <repo>/media).
# MEDIA_ROOT=/absolute/path/to/media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Parallel FFmpeg renders per worker process, and the per-command timeout
RENDER_CONCURRENCY=1
RENDER_TIMEOUT_SECONDS=600
