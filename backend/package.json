{
  "name": "@cineos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "smoke": "tsx src/scripts/smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "bullmq": "^5.52.0",
    "express": "^5.3.0",
    "ioredis": "^5.6.0",
    "mongoose": "^9.12.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
